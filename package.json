{
  "name": "testrepo",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace-local REA reverse-engineering tools",
  "scripts": {
    "rea": "sh scripts/rea.sh",
    "rea:doctor": "npm run rea -- doctor --json",
    "rea:mcp": "npm run rea -- mcp",
    "rea:install-android": "python3 scripts/install-android-tools.py",
    "test:web": "node --test tests/*.cjs",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "build:web": "npm run theme:build && node scripts/build-web.mjs",
    "theme:build": "npm run astryx -- theme build src/themes/sourcebook/sourcebookTheme.ts",
    "check:design": "npm run astryx -- doctor --built web"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.12",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "node": "22.23.4",
    "rea-agents": "6.8.0"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.12",
    "@astryxdesign/theme-matcha": "^0.7.12",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
