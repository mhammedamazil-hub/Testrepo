# ---- InstantMesh Studio: server-side configuration ----
# Copy to .env and `export $(grep -v '^#' .env | xargs)` (or use your platform's
# secret manager). NEVER commit real values, and never move these into frontend code.

# Which provider the UI defaults to: mock | hf_space | replicate | local_gpu
IM_PROVIDER=mock

# --- Provider: official HF Space (free ZeroGPU quota) ---
HF_SPACE_ID=TencentARC/InstantMesh
# Optional. Without it you are an anonymous visitor (~2 GPU-min/day).
# With a free-account token you get that account's quota (~5 GPU-min/day).
HF_TOKEN=
HF_TIMEOUT_S=900

# --- Provider: Replicate (paid, per-second GPU billing, ~$0.14/run) ---
REPLICATE_API_TOKEN=
REPLICATE_MODEL=aryamansital/instant_mesh
REPLICATE_TIMEOUT_S=900

# --- Provider: local NVIDIA GPU running the official repo ---
LOCAL_GPU_PYTHON=python
LOCAL_GPU_REPO=./vendor/InstantMesh
LOCAL_GPU_CONFIG=configs/instant-mesh-large.yaml

# --- Server ---
IM_HOST=0.0.0.0
IM_PORT=8000
IM_MAX_UPLOAD_BYTES=12582912
IM_JOB_TTL_HOURS=24
IM_MAX_CONCURRENT_JOBS=2
# Set to 0 to skip the provider reachability probes on /api/providers
IM_PROBE_NETWORK=1
