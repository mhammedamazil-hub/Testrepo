# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# App runtime data (user uploads + generated meshes)
app/storage/

# Cloned upstream repos (models are ~7GB of weights; never commit)
vendor/

# Local secrets
.env
.env.local

# Local notebook output (kept narrow on purpose: broad *.glb/*.obj globs once
# silently excluded a real generated mesh from the CI commit-back)
/outputs/

# CI results ARE committed on purpose - they are the evidence
!ci_results/**

# scratch
image-search/
tmp_gtest/
renders/
ci_run/

# Villa: generated texture sets and render frames (regenerate with villa_src/tex_gen.py)
villa/tex/
villa/tex_256/
villa/tex_512/
villa/walkthrough_frames/
villa/villa.blend1
*.blend1
.glstub/*.so
.glstub/*.so.*

# v2 deliverable: the GLBs ARE committed (both sizes, ~93 MB) because they are the
# hand-off artefact. The .blend stays out: 15 MB, and it is rebuilt by one command.
# villa_v2/*.glb        <- deliberately NOT ignored
villa_v2/*.blend
villa_v2/*.blend1

# packed viewer asset: generated by tools/villa_pack.py, rebuilt by CI
android/viewer/app/src/main/assets/*.vpk
android/viewer/app/build/
android/viewer/.gradle/
android/viewer/local.properties
