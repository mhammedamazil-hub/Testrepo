# Heavy, reproducible render products stay outside Git.
output/*
!output/.gitkeep
__pycache__/
*.pyc
.venv/
# Blender backups
*.blend1
*.blend2
# Game imports, downloaded toolchains, test browsers and reproducible exports
.cache/
.godot/
.exports/
node_modules/
# Godot extracts these embedded GLB images during import; reproduce from GLB.
/game/assets/terrain_*.png*
/game/assets/road_asphalt.png*

# Godot-generated embedded branch atlas; original spruce_shoot.png is authored.
/game/assets/spruce_near_*.png*

# Reproducible custom browser runtime and Godot-extracted embedded maps.
/engine/dist/
/game/assets/library/pine_*.png*
/game/assets/library/grass_*.png*
!/game/assets/library/pine_twig_rgba.png
!/game/assets/library/grass_blades_rgba.png

/game/assets/library/pine_bark_*.jpg*
/game/assets/library/grass_grass_*
